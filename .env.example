# ─── LangGraph Pipeline API ────────────────────────────────────────────────────
# Copy this to .env and fill in your values

# ─── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here

# ─── DevBlog REST API ──────────────────────────────────────────────────────────
# The Next.js DevBlog running locally or deployed
DEVBLOG_BASE_URL=http://localhost:3000
DEVBLOG_API_SECRET_KEY=your_devblog_api_secret_key_here

# ─── Telegram Bot ──────────────────────────────────────────────────────────────
# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here
# Your personal Telegram chat ID (run /start with the bot, then check getUpdates)
TELEGRAM_CHAT_ID=your_chat_id_here

# ─── Database (Postgres via Docker) ────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://pipeline:pipeline@localhost:5434/pipeline
DATABASE_URL_SYNC=postgresql://pipeline:pipeline@localhost:5434/pipeline

# ─── Redis (LangGraph checkpointer via Docker) ─────────────────────────────────
REDIS_URL=redis://localhost:6381

# ─── Pipeline settings ─────────────────────────────────────────────────────────
# Max cost per run in USD before Telegram warning is sent
MAX_COST_PER_RUN_USD=1.00
# How many hours to skip a topic that was recently published
TOPIC_COOLDOWN_HOURS=168

# ─── Search (optional — DuckDuckGo used if not set) ───────────────────────────
# SERPER_API_KEY=your_serper_api_key_here

# ─── n8n (for reference) ───────────────────────────────────────────────────────
# N8N runs at http://localhost:5678
# Webhook callback URL: http://host.docker.internal:8000/pipeline/callback/{run_id}
