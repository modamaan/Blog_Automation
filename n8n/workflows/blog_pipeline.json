{
  "id": "PHqe9IVx9hehEWIZ",
  "name": "DevBlog Autonomous Pipeline",
  "nodes": [
    {
      "parameters": {
        "updates": [
          "message",
          "callback_query"
        ]
      },
      "name": "Telegram Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1,
      "position": [
        0,
        100
      ],
      "webhookId": "devblog-telegram-webhook"
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.callback_query ? true : false }}",
              "value2": true
            }
          ]
        }
      },
      "name": "Is Callback?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        200,
        100
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8000/pipeline/run",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "topic",
              "value": "={{ $json.message.text }}"
            }
          ]
        },
        "options": {}
      },
      "name": "Trigger Pipeline from Telegram",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        450,
        200
      ]
    },
    {
      "parameters": {
        "chatId": "={{ $json.message.chat.id }}",
        "text": "\ud83d\ude80 Acknowledged! Starting pipeline for YouTube video...",
        "additionalFields": {}
      },
      "name": "Telegram Acknowledge",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.1,
      "position": [
        650,
        200
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ 'http://host.docker.internal:8000/telegram/callback/' + $json.callback_query.data.split(':')[1] }}",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "action",
              "value": "={{ $json.callback_query.data.split(':')[0] }}"
            }
          ]
        },
        "options": {}
      },
      "name": "Resume Pipeline",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        450,
        0
      ]
    },
    {
      "parameters": {
        "operation": "answerCallbackQuery",
        "queryId": "={{ $json.callback_query.id }}",
        "text": "={{ $json.callback_query.data.split(':')[0] === 'approve' ? '\u2705 Post approved! Publishing now...' : '\u274c Post rejected.' }}",
        "showAlert": true
      },
      "name": "Telegram Reply",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.1,
      "position": [
        650,
        0
      ]
    }
  ],
  "connections": {
    "Telegram Trigger": {
      "main": [
        [
          {
            "node": "Is Callback?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Is Callback?": {
      "main": [
        [
          {
            "node": "Resume Pipeline",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Trigger Pipeline from Telegram",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Resume Pipeline": {
      "main": [
        [
          {
            "node": "Telegram Reply",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Trigger Pipeline from Telegram": {
      "main": [
        [
          {
            "node": "Telegram Acknowledge",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  }
}